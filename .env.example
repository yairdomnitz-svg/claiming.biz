# Master switch for everything that costs money. Defaults to false, so a
# deploy does not start spending the moment a key is present. Set to true
# to turn the analyzer on.
ANALYSIS_ENABLED=false

# Hard ceiling on estimated spend per UTC day. 0 disables.
# DAILY_BUDGET_USD=2.0

# Required: your xAI key from https://console.x.ai
XAI_API_KEY=

# Optional model / tuning overrides
GROK_MODEL=grok-4.3
# XAI_BASE_URL=https://api.x.ai/v1
# GROK_TIMEOUT=120
# GROK_MAX_TOKENS=8000
# GROK_TEMPERATURE=0.2
# MAX_TRANSCRIPT_CHARS=100000
# TRANSCRIPT_TIMEOUT=45
# TRANSCRIPT_HTTP_TIMEOUT=10
# TRANSCRIPT_WORKERS=8

# Abuse / cost control. Set RATE_LIMIT_REQUESTS=0 to disable.
# RATE_LIMIT_REQUESTS=10
# RATE_LIMIT_WINDOW=600
# Ceiling across all callers, so many IPs cannot together bypass the per-IP limit.
# GLOBAL_RATE_LIMIT_REQUESTS=300
# GLOBAL_RATE_LIMIT_WINDOW=3600

# Number of proxies that append to X-Forwarded-For before the request arrives.
# 1 = Railway alone. Set to 2 if a CDN (e.g. Cloudflare's orange cloud) sits in
# front, or every visitor collapses into a single rate-limit bucket.
# TRUSTED_PROXY_HOPS=1

# Restrict browser access. Defaults to SITE_URL and its www. form. "*" alone is
# allowed; "*" mixed with explicit origins is refused at startup.
# ALLOWED_ORIGINS=https://claimifi.biz,https://www.claimifi.biz

# YouTube blocks datacenter IPs, so transcript fetching fails on Railway
# unless requests go through a residential proxy. Use either Webshare:
# Get these from https://dashboard.webshare.io/proxy/settings after buying a
# "Residential" package. NOT "Proxy Server" and NOT "Static Residential".
# WEBSHARE_PROXY_USERNAME=
# WEBSHARE_PROXY_PASSWORD=
# Retries when an exit node is blocked; each retry rotates to a new IP.
# WEBSHARE_RETRIES=2
# Optional country codes to pin the exit pool nearer your region.
# WEBSHARE_IP_LOCATIONS=nl,de,gb
# ...or any HTTP(S) proxy URL:
# PROXY_URL=http://user:pass@host:port

# LOG_LEVEL=INFO
