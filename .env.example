# Required: your xAI key from https://console.x.ai
XAI_API_KEY=

# Optional model / tuning overrides
GROK_MODEL=grok-4
# GROK_TIMEOUT=120
# GROK_MAX_TOKENS=8000
# GROK_TEMPERATURE=0.2
# MAX_TRANSCRIPT_CHARS=100000
# TRANSCRIPT_TIMEOUT=30

# Abuse / cost control. Set RATE_LIMIT_REQUESTS=0 to disable.
# RATE_LIMIT_REQUESTS=10
# RATE_LIMIT_WINDOW=600

# Restrict browser access. Default "*" allows any origin.
# ALLOWED_ORIGINS=https://claimifi.biz,https://www.claimifi.biz

# YouTube blocks datacenter IPs, so transcript fetching fails on Railway
# unless requests go through a residential proxy. Use either Webshare:
# WEBSHARE_PROXY_USERNAME=
# WEBSHARE_PROXY_PASSWORD=
# ...or any HTTP(S) proxy URL:
# PROXY_URL=http://user:pass@host:port

# LOG_LEVEL=INFO
